# ===== 应用形态 =====
APP_HOST=127.0.0.1             # 仅本机监听
APP_PORT=8765                  # 0 表示自动分配空闲端口
APP_TITLE=ScholarMate
APP_SIZE=1280x800

# ===== LLM 主模型 =====
LLM_PROVIDER=deepseek        # deepseek | qwen | claude

# DeepSeek（2026-07-24 起使用 V4 模型名）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash   # 通用对话
# DEEPSEEK_MODEL=deepseek-v4-pro   # 复杂规划

# 通义千问（备用模型，OpenAI 兼容端点）
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_MODEL=qwen-plus

# Anthropic Claude（可选）
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===== Embedding（DashScope；DeepSeek 无 Embedding 接口）=====
EMBEDDING_PROVIDER=dashscope   # dashscope | local
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_MODEL=bge-m3        # 本地备选（需安装 FlagEmbedding）

# ===== 翻译专用 LLM（默认千问 VL，可识图；与 Agent 对话 LLM 独立）=====
TRANSLATION_PROVIDER=qwen          # qwen | deepseek
TRANSLATION_MODEL=qwen-vl-max      # 识图翻译推荐 qwen-vl-max / qwen3-vl-plus；纯文本可改 qwen-plus
TRANSLATION_VISION=true            # 版面对照模式下发送段落截图给模型

# ===== 外部 API =====
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex（免 key 备用元数据源；填写邮箱可进入礼貌池提升限流，建议填毕设用邮箱）
OPENALEX_MAILTO=

# ===== 应用配置 =====
# 数据库：默认 SQLite（桌面交付形态，零安装）
DATABASE_URL=sqlite+aiosqlite:///./data/scholar_mate.db
# 开发 / 答辩演示可切换 MySQL（Navicat 可视化），需先建库并授权：
# DATABASE_URL=mysql+aiomysql://scholarmate:密码@127.0.0.1:3306/scholarmate?charset=utf8mb4
CHROMA_PERSIST_DIR=./data/chroma_db
PDF_UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
